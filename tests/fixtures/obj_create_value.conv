{.profile: kernel.}
from core/mem import pageAllocator
from core/io import println

type
  Node* = object
    id*: int
    name*: string

proc main(): !void =
  let a = pageAllocator()
  let p = try a.create(Node, Node(id: 5))
  defer: a.destroy(p)
  defer: p.name.deinit()
  assert(p.id == 5)
  assert(p.name.len == 0)
  let v = p[]
  assert(v.id == 5)
  var w = p[]
  w.id = 9
  assert(p.id == 5)
  try println("create-value-ok")
