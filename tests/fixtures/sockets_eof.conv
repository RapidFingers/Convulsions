{.profile: kernel.}
import core/net
import core/concurrency
import core/slice
import core/mem
import core/io

proc serve(l: Socket): !void =
  let c = try l.accept()
  defer: c.close()
  try write(c, "bye".bytes())
  shutdownWrite(c)

proc main(): !void =
  let l = try listen("127.0.0.1", 0)
  defer: l.close()
  let srv = spawn serve(l)
  let s = try connect("127.0.0.1", l.localPort())
  defer: s.close()
  let a = taskAllocator()
  let buf = try newBuffer(a, 64)
  defer: deinitBuffer(buf)
  let n = try readInto(s, buf.slice())
  assert(n == 3)
  let got = buf.view(n)
  assert(got.at(0) == 'b')
  let eof = readInto(s, buf.slice()) catch:
    error.Closed => 0
    else => propagate
  assert(eof == 0)
  try await srv
  try println("sockets-eof-ok")
