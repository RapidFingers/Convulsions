{.profile: kernel.}
import core/net
import core/concurrency
import core/mem
import core/string
import core/io

proc serve(l: Socket): !void =
  let c = try l.accept()
  defer: c.close()
  try write(c, "bye")

proc main(): !void =
  let l = try listen("127.0.0.1", 0)
  defer: l.close()
  let srv = spawn serve(l)
  let s = try connect("127.0.0.1", l.localPort())
  defer: s.close()
  let a = taskAllocator()
  let got = try read(s, a, 64)
  defer: got.deinit()
  assert(equal(got, "bye"))
  let eof = try read(s, a, 64)
  defer: eof.deinit()
  assert(eof.len == 0)
  try await srv
  try println("sockets-eof-ok")
