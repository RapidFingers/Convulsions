{.profile: kernel.}
from core/mem import cAllocator
from core/string import runeAt, runeOffset, runeLen, validate, rune, fromRune
from core/io import println

proc main(): !void =
  let s = "привет🙂"
  assert(validate(s))
  assert(s.len == 16)
  assert(runeLen(s) == 7)
  assert(int(try runeAt(s, 0)) == 0x43F)
  assert(int(try runeAt(s, 12)) == 0x1F642)
  assert((try runeOffset(s, 6)) == 12)
  assert((try runeOffset(s, 7)) == 16)
  assert('A' == '\x41')
  assert(int('A') == 65)
  assert(1 == 1, "ok")
  let a = cAllocator()
  let t = try fromRune(a, try rune(0x1F600))
  defer: t.deinit()
  try println(s)
  try println(t)
