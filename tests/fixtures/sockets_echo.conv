{.profile: kernel.}
import core/net
import core/concurrency
import core/slice
import core/mem
import core/io

proc serve(l: Socket): !void =
  let c = try l.accept()
  defer: c.close()
  let a = taskAllocator()
  let buf = try newBuffer(a, 256)
  defer: deinitBuffer(buf)
  let n = try readInto(c, buf.slice())
  if n > 0:
    try write(c, buf.view(n))

proc main(): !void =
  let l = try listen("127.0.0.1", 0)
  defer: l.close()
  let srv = spawn serve(l)
  let s = try connect("127.0.0.1", l.localPort())
  defer: s.close()
  let a = taskAllocator()
  let buf = try newBuffer(a, 256)
  defer: deinitBuffer(buf)
  try write(s, "echo!".bytes())
  let n = try readInto(s, buf.slice())
  assert(n == 5)
  let got = buf.view(n)
  assert(got.at(0) == 'e')
  try await srv
  try println("sockets-echo-ok")
