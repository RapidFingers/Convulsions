{.profile: kernel.}
from core/mem import cAllocator
from core/string import concat
from core/io import println

proc note(): void =
  discard 1

proc main(): !void =
  let a = cAllocator()
  let x = try concat(a, "x", "")
  let y = try concat(a, "y", "")
  defer:
    note()
    x.deinit()
  defer: y.deinit()
  try println(x)
