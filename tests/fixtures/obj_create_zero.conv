{.profile: kernel.}
from core/mem import pageAllocator
from core/string import validate
from core/io import println

type
  Node* = object
    id*: int
    name*: string

proc main(): !void =
  let a = pageAllocator()
  let p = try a.create(Node)
  defer: a.destroy(p)
  defer: p.name.deinit()
  assert(p.id == 0)
  assert(p.name.len == 0)
  assert(validate(p.name))
  try println("create-zero-ok")
