{.profile: kernel.}
import core/net
import core/concurrency
import core/slice
import core/mem
import core/string
import core/io

proc handle(c: Socket): !void =
  defer: c.close()
  let a = taskAllocator()
  let buf = try newBuffer(a, 256)
  defer: deinitBuffer(buf)
  let n = try readInto(c, buf.slice())
  if n > 0:
    try write(c, buf.view(n))

proc server(l: Socket): !void =
  var n = 0
  while n < 2:
    n = n + 1
    let c = try l.accept()
    discard spawn handle(c)

proc client(port: int): !void =
  let s = try connect("127.0.0.1", port)
  defer: s.close()
  try write(s, "ping".bytes())
  let a = taskAllocator()
  let buf = try newBuffer(a, 256)
  defer: deinitBuffer(buf)
  let n = try readInto(s, buf.slice())
  assert(n == 4)
  let got = buf.view(n)
  assert(got.at(0) == 'p')

proc main(): !void =
  let l = try listen("127.0.0.1", 0)
  defer: l.close()
  let srv = spawn server(l)
  let c1 = spawn client(l.localPort())
  let c2 = spawn client(l.localPort())
  try await c1
  try await c2
  try await srv
  try println("sockets-multi-ok")
