{.profile: kernel.}
{.header: "<cvnrt_net.h>".}
import core/slice

type
  Socket* {.importc: "cvn_socket", header: "<cvnrt_net.h>".} = object

proc listen*(host: string, port: int): !Socket
  {.importc: "cvn_net_listen", cdecl.}

proc accept*(s: Socket): !Socket
  {.importc: "cvn_net_accept", cdecl.}

proc connect*(host: string, port: int): !Socket
  {.importc: "cvn_net_connect", cdecl.}

proc cvnNetReadInto(s: Socket, buf: ptr byte, maxBytes: int): !int
  {.importc: "cvn_net_read_into", cdecl.}

proc cvnNetWriteBytes(s: Socket, buf: ptr byte, n: int): !void
  {.importc: "cvn_net_write_bytes", cdecl.}

proc readInto*(s: Socket, buf: Slice[byte]): !int =
  return cvnNetReadInto(s, buf.data, buf.len)

proc write*(s: Socket, data: Slice[byte]): !void {.propagate.} =
  cvnNetWriteBytes(s, data.data, data.len)

proc close*(s: Socket): void
  {.importc: "cvn_net_close", cdecl.}

proc shutdownWrite*(s: Socket): void
  {.importc: "cvn_net_shutdown_write", cdecl.}

proc localPort*(s: Socket): int
  {.importc: "cvn_net_local_port", cdecl.}
